# WeBothPlay — environment variables (copy to .env.local for development).
# Never commit real values. Production values live in Vercel → Settings → Environment Variables.
# Full explanations: docs/retrofit/OWNER_OPERATIONS_GUIDE.md §3

# ── Required ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/webothplay   # Supabase: use the pooled connection string
STEAM_API_KEY=                     # https://steamcommunity.com/dev/apikey (server-only; never NEXT_PUBLIC_)
SESSION_SECRET=                    # 32+ random characters: openssl rand -hex 32
CRON_SECRET=                       # random string; Vercel Cron sends it as a Bearer token: openssl rand -hex 24

# ── Owner tools ─────────────────────────────────────────────────────────────
ADMIN_STEAM_IDS=                   # your SteamID64 (comma-separated for several) → unlocks /admin
OWNER_ALERT_WEBHOOK_URL=           # Discord channel webhook for alerts
OWNER_REPORT_WEBHOOK_URL=          # optional: separate channel for the Monday report (falls back to the alert webhook)

# ── Payments (Stripe) ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=                 # sk_live_… / rk_live_… (restricted key recommended)
STRIPE_WEBHOOK_SECRET=             # whsec_… for https://webothplay.com/api/webhooks/stripe
STRIPE_PRICE_ID_PRO=               # price_… monthly
STRIPE_PRICE_ID_HACKER=            # price_… monthly
STRIPE_PRICE_ID_PRO_ANNUAL=        # optional: annual prices show on /upgrade only when set
STRIPE_PRICE_ID_HACKER_ANNUAL=
STRIPE_AUTOMATIC_TAX=              # set to 1 only after enabling Stripe Tax registrations
KOFI_WEBHOOK_VERIFICATION_TOKEN=   # legacy Ko-fi path; webhook refuses everything without it

# ── Discord bot ↔ website ───────────────────────────────────────────────────
BOT_API_KEY=                       # shared with the bot; protects bot-only endpoints (same value in bot/.env)
DISCORD_LINK_SECRET=               # shared with the bot; signs /dashboard?link_discord links (same value in bot/.env)

# ── Public (safe in the browser) ────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://webothplay.com
NEXT_PUBLIC_GA_ID=                 # defaults to the existing GA property
NEXT_PUBLIC_DISCORD_INVITE_URL=    # a permanent (never-expiring) invite to your community server
NEXT_PUBLIC_DISCORD_BOT_INSTALL_URL=   # defaults to the current bot's OAuth URL
NEXT_PUBLIC_SUPPORT_EMAIL=         # a support alias (defaults to the address on the old contact page)
NEXT_PUBLIC_AFFILIATE_HUMBLE=      # optional, only after approval; must contain {url}
NEXT_PUBLIC_AFFILIATE_GMG=
NEXT_PUBLIC_AFFILIATE_FANATICAL=

# ── Development only ────────────────────────────────────────────────────────
STEAM_MOCK=                        # 1 = fixture libraries, no Steam calls (npm run dev:mock)
