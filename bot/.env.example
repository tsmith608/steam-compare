# WeBothPlay Discord bot — copy to bot/.env on the server that runs the bot.
DISCORD_TOKEN=            # Discord Developer Portal → your app → Bot → Reset Token
DISCORD_CLIENT_ID=        # Application ID
GUILD_ID=                 # optional: deploy commands to one test server instantly
BOT_API_BASE=https://webothplay.com
BOT_API_KEY=              # same value as the website's BOT_API_KEY
DISCORD_LINK_SECRET=      # same value as the website's DISCORD_LINK_SECRET
